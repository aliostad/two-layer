resource_group_name   = "rg-two-layer-demo"
location              = "westeurope"
app_service_plan_name = "asp-two-layer-demo"

# Must be globally unique across Azure.
layer1_app_name = "two-layer-batch-<unique-suffix>"
layer2_app_name = "two-layer-simulator-<unique-suffix>"

# Must be globally unique and alphanumeric only (no dashes).
acr_name = "twolayeracr<unique-suffix>"

# Docker image tag — bump this to force a redeploy.
image_tag = "latest"
